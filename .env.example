# Copy to `.env` and fill in. The real `.env` is git-ignored.

NODE_ENV=development
PORT=5000

# Comma-separated list of origins allowed to call the API.
FRONTEND_URL=http://localhost:3000

# `npm run dev:db` starts a local mongod at this address.
# For production, use your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/keremduz

# Signs admin session tokens. Use a long random string; never reuse the sample.
JWT_SECRET=change-me-to-a-long-random-string

# HMAC salt used to anonymize visitor IP addresses. Use a different long random
# value from JWT_SECRET in production.
ANALYTICS_HASH_SALT=change-me-to-another-long-random-string

# Read once by `npm run seed` when creating the /admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Only needed for image uploads from the admin panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (frontend/.env.local) — public site address, used for canonical URLs,
# sitemap, robots.txt and Open Graph tags. Must be the real domain in production.
# NEXT_PUBLIC_SITE_URL=https://www.keremduz.com

# Server-only address of the Express API. Browser requests use the same-origin
# /api gateway configured by Next.js.
BACKEND_API_URL=http://localhost:5000/api

# Google Search Console verification token (optional).
# NEXT_PUBLIC_GOOGLE_VERIFICATION=

# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional direct browser-to-API escape hatch. The same-origin gateway is safer.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
